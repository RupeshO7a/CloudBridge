generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id // Firebase UID
  email        String   @unique
  displayName  String?
  createdAt    DateTime @default(now())

  sentShares     Share[] @relation("SentShares")
  receivedShares Share[] @relation("ReceivedShares")
}

model Share {
  id             String    @id @default(uuid())
  senderId       String
  sender         User      @relation("SentShares", fields: [senderId], references: [id])
  recipientId    String
  recipient      User      @relation("ReceivedShares", fields: [recipientId], references: [id])

  contentType    String    // "text" | "url" | "file"
  textContent    String?   // used when contentType is "text" or "url"
  fileUrl        String?   // used when contentType is "file"
  fileName       String?
  fileSize       Int?

  allowDownload  Boolean   @default(true)
  expiresAt      DateTime
  status         String    @default("pending") // pending | accepted | declined | expired | revoked

  createdAt      DateTime  @default(now())
}