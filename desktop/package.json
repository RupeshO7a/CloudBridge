{
  "name": "desktop",
  "version": "1.0.0",
  "description": "CloudBridge desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "electron": "^45.0.0",
    "electron-store": "^8.2.0",
    "firebase": "^13.1.0",
    "node-fetch": "^2.7.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cloudbridge.desktop",
    "productName": "CloudBridge",
    "protocols": [
      {
        "name": "CloudBridge Authentication",
        "schemes": [
          "cloudbridge"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}